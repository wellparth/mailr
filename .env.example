# Mailr Root Environment Configuration Template

# Database (Local XAMPP default: root without password on 127.0.0.1:3306)
DATABASE_URL="mysql://root:@127.0.0.1:3306/mailr_dev"

# 32-byte (64 hex characters) AES-256-GCM Master Encryption Key
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret
JWT_SECRET=super_secret_jwt_mailr_dev_key_2026_xyz

# Domain name & URLs
DOMAIN_NAME=mailr.yourdomain.com
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Microsoft Outlook / Azure AD OAuth Credentials (Azure Portal -> App Registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
