# =======================================================
# Mailr Monorepo Git Ignore
# Excludes dependencies, builds, caches, secrets, and OS files
# =======================================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Next.js Build Output & Cache
.next/
*/.next/
out/
*/out/

# Backend Build & Transpilation Output
dist/
*/dist/
build/
*/build/
*.tsbuildinfo

# Environment & Secret Files (NEVER commit live secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.*
!*.env.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx

# Logs & Runtime Process IDs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Temporary / Scratch Files & Working Documents
*.docx
*.tmp
*.temp
scratch/
.taste-skill/
check-ui.js
frontend/check-ui.js
ui-check.png
frontend/ui-check.png

# Markdown Files (Only README.md is tracked on Git)
*.md
!README.md
